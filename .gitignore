/pub/sitemap.xml
/.idea
/.gitattributes

# Credentials — NEVER commit
/auth.json
/var/credentials_email.txt

# Magento 2 generated / runtime
/app/config_sandbox
/app/etc/config.php
/app/etc/env.php
/app/code/Magento/TestModule*
/lib/internal/flex/test
/generated/*
!/generated/.htaccess
/pub/media/*
!/pub/media/.htaccess
/pub/static/*
!/pub/static/.htaccess
/var/*
!/var/.htaccess

# Vendor (managed by Composer)
/vendor/*
!/vendor/.htaccess

# Node / frontend build
/node_modules
**/node_modules
/grunt-config.json
/Gruntfile.js
/package.json
/package-lock.json

# Tailwind build output (regenerated from source)
app/design/frontend/Phpure/golf/web/css/
app/design/frontend/Phpure/golf/web/tailwind/generated/
app/design/frontend/Phpure/golf/web/tailwind/package-lock.json

# OS files
.DS_Store
Thumbs.db

# ── PHPure Golf Hyvä UI POC ──
# Vite build output
/dist

# hyva-ui kit is commercial and lives outside this repo — symlink only
/hyva-ui-reference

# Saved MCP tool-result dumps
/.claude/tool-results

# Per-user Claude Code overrides (agent files + project settings.json are shared)
/.claude/settings.local.json

# hyva-ai-tools skills are symlinked from the user's clone of
# https://github.com/hyva-themes/hyva-ai-tools — symlinks are not portable
# across machines. Each contributor installs the skills locally (see README).
/.claude/skills

# Override Magento's /package.json and /package-lock.json ignores — the POC
# has its own npm workspace at the repo root (Vite + Tailwind + Alpine).
!/package.json
!/package-lock.json
